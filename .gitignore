.gradle/
**/.gradle/
**/build/
*.lock
*.bin

# Node & Frontend build
node_modules/
dist/
*.log

# Python
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc

# IDE & OS
.idea/
.vscode/
.DS_Store

.vercel
.env*

# Local runtime data
.farmflate-postgres-data/
.superpowers/
