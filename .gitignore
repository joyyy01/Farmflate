/test_ai_retest.py
/test_e2e.py
/docs/superpowers/plans/
/docs/superpowers/specs/

# Keep linked worktrees out of the repository while allowing reviewed design specs.
/.worktrees/
!/docs/
!/docs/superpowers/
!/docs/superpowers/specs/
!/docs/superpowers/specs/*.md

# Keep local Windows launchers and notes out of the repository.
*.bat
*.md

# Design specifications are reviewed project artifacts, not local notes.
!/docs/
!/docs/superpowers/
!/docs/superpowers/specs/
!/docs/superpowers/specs/*.md

# Decision records and operational runbooks preserve the rationale and evidence
# for production-facing RAG/Agent changes.
!/docs/adr/
!/docs/adr/*.md
!/docs/plans/
!/docs/plans/2026-07-29-postgresql-rag-agent.md
!/docs/rag-agent-architecture.md
!/docs/rag-agent-operations.md
!/docs/evidence/
!/docs/evidence/*.md

# Share the contract, never the populated local secret file.
!.env.example
