# Copy to .env and fill secrets locally. Never commit .env.
SPRING_PROFILES_ACTIVE=local
APP_FRONTEND_URL=http://localhost:5173
PYTHON_SERVER_URL=http://127.0.0.1:8000

# Register this exact URI in the Kakao Developers console before login testing.
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

JWT_SECRET=
PYTHON_INTERNAL_API_KEY=
DATA_GO_KR_SERVICE_KEY=
VWORLD_API_KEY=
PARCEL_IDENTIFIER_API_KEY=

# Spring Boot and Python RAG share the same local PostgreSQL instance.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=interview_db
DB_USER=farmflate
DB_PASS=

# OpenAI generates answers and, only when hybrid is enabled, embeddings.
OPENAI_API_KEY=
NONGSARO_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
AGENT_MAX_OUTPUT_TOKENS=800
# Bump when the Agent prompt, schema, tool policy, or citation contract changes.
AGENT_PIPELINE_VERSION=sectioned-citations-v3
RAG_HYBRID_ENABLED=false
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_SEMANTIC_AVAILABILITY_TTL_SECONDS=60
RAG_EVALUATION_MIN_CASES=30
RAG_HYBRID_MIN_RECALL_DELTA=0.05
RAG_HYBRID_MAX_CITATION_PRECISION_DROP=0.0
RAG_HYBRID_MAX_P95_LATENCY_RATIO=1.5

# Optional read-only MCP server. Keep disabled until the local Spring and
# Python servers share a non-empty MCP_SPRING_INTERNAL_TOKEN.
MCP_ENABLED=false
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ACCESS_TOKEN=
MCP_SPRING_BASE_URL=http://127.0.0.1:8080
MCP_SPRING_INTERNAL_TOKEN=
